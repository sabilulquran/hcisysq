NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://hcis_local:replace-me@127.0.0.1:54329/hcis_local
ADMS_INGRESS_HOST=adms.sabilulquran.or.id
AUTH_MODE=local
AUTH_ENCRYPTION_KEY=replace-with-64-hex-characters
AUTH_SESSION_TTL_HOURS=8
MOBILE_ATTENDANCE_ENABLED=0

# Restricted attendance photos reuse the configured encrypted-media keyring.
BIOMETRIC_COLLECTION_ENABLED=0
BIOMETRIC_ACTIVE_KEY_ID=
BIOMETRIC_ENCRYPTION_KEYS=

# Required only when AUTH_MODE=oidc. Keep secrets outside the repository.
OIDC_ISSUER=https://login-staging.sabilulquran.or.id/realms/sq-staff-staging
OIDC_CLIENT_ID=hcis-staging
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=https://hcis-staging.sabilulquran.or.id/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://hcis-staging.sabilulquran.or.id/
SQ_HUB_APPLICATION_ACCESS_URL=https://hub-staging.sabilulquran.or.id/internal/v1/application-access/check
# AUTH-013 launcher: derived from SQ_HUB_APPLICATION_ACCESS_URL (.../check -> .../launcher); set only to override.
# SQ_HUB_APPLICATION_LAUNCHER_URL=
SQ_HUB_MACHINE_CLIENT_ID=hcis-api-staging
SQ_HUB_MACHINE_CLIENT_SECRET=replace-me
# ASSET-001: Aset SQ person custody (ASQ-004). Leave all three empty to keep it off;
# the client is dedicated (hcis-aset-custody), never the SQ Hub machine client.
ASET_SQ_PERSON_CUSTODY_URL=
ASET_SQ_MACHINE_CLIENT_ID=
ASET_SQ_MACHINE_CLIENT_SECRET=
# ASET_SQ_SELF_SERVICE_URL=https://aset.sabilulquran.or.id/my-assets

# CAL-001 §9.2 WhatsApp through Kirim SQ (SQ Hub ADR-0011). `log` sends nothing (dry run) and is the
# default until the HCIS number is paired in Kirim SQ; `kirim` needs all four KIRIM_* values below.
WHATSAPP_ADAPTER=log
# KIRIM_BASE_URL=http://127.0.0.1:3302
# KIRIM_TOKEN_URL=https://login.sabilulquran.or.id/realms/sq-staff/protocol/openid-connect/token
# KIRIM_CLIENT_ID=
# KIRIM_CLIENT_SECRET=
# KIRIM_AUDIENCE=sq-hub-kirim
# KIRIM_DEVICE_HCIS=hcis
# CAL-001 §9.3 reminder and WhatsApp runner inside the API process; 0 disables it.
MEETING_RUNNER_ENABLED=1
