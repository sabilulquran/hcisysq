NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://hcis_local:replace-me@127.0.0.1:54329/hcis_local
ADMS_INGRESS_HOST=adms.sabilulquran.or.id
AUTH_MODE=local
AUTH_ENCRYPTION_KEY=replace-with-64-hex-characters
AUTH_SESSION_TTL_HOURS=8
MOBILE_ATTENDANCE_ENABLED=0

# Restricted attendance photos reuse the configured encrypted-media keyring.
BIOMETRIC_COLLECTION_ENABLED=0
BIOMETRIC_ACTIVE_KEY_ID=
BIOMETRIC_ENCRYPTION_KEYS=

# Required only when AUTH_MODE=oidc. Keep secrets outside the repository.
OIDC_ISSUER=https://login-staging.sabilulquran.or.id/realms/sq-staff-staging
OIDC_CLIENT_ID=hcis-staging
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=https://hcis-staging.sabilulquran.or.id/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://hcis-staging.sabilulquran.or.id/
SQ_HUB_APPLICATION_ACCESS_URL=https://hub-staging.sabilulquran.or.id/internal/v1/application-access/check
SQ_HUB_MACHINE_CLIENT_ID=hcis-api-staging
SQ_HUB_MACHINE_CLIENT_SECRET=replace-me
