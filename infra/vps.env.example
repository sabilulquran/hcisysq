POSTGRES_DB=hcis_dev
POSTGRES_USER=hcis_app
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Generate with: openssl rand -hex 32
# Never commit the real key. Rotating this key invalidates encrypted MFA secrets.
AUTH_ENCRYPTION_KEY=replace_with_64_hex_characters
AUTH_SESSION_TTL_HOURS=8

# HUB-IMPL-003 production authentication. Keep all secrets outside the repository.
# Use AUTH_MODE=local only before the approved cutover or during an owner-directed rollback.
AUTH_MODE=oidc
OIDC_ISSUER=https://login.sabilulquran.or.id/realms/sq-staff
OIDC_CLIENT_ID=hcis
OIDC_CLIENT_SECRET=replace_with_hcis_production_client_secret
OIDC_REDIRECT_URI=https://hcis.sabilulquran.or.id/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://hcis.sabilulquran.or.id/

# Application Access remains private on the shared production Docker network.
SQ_HUB_APPLICATION_ACCESS_URL=http://sq-hub-production-api-1:3100/internal/v1/application-access/check
SQ_HUB_MACHINE_CLIENT_ID=hcis-api
SQ_HUB_MACHINE_CLIENT_SECRET=replace_with_hcis_api_production_service_secret

# ATT-004 production machine ingress. DNS/Caddy cutover requires
# operator/human approval before any physical device is redirected.
ADMS_INGRESS_HOST=adms.sabilulquran.or.id

# ATT-005 Wave 2 biometric vault. Keep collection OFF until retention,
# backup/deletion policy, key ownership and the controlled hardware canary are approved.
# The biometric keyring is intentionally separate from AUTH_ENCRYPTION_KEY.
# When enabled, BIOMETRIC_ENCRYPTION_KEYS is a JSON object whose values are
# independently generated 32-byte hex keys. Never commit a real keyring.
BIOMETRIC_COLLECTION_ENABLED=0
BIOMETRIC_ACTIVE_KEY_ID=
BIOMETRIC_ENCRYPTION_KEYS=

# Existing shared Caddy Docker network on the VPS.
EDGE_NETWORK=edge_proxy
SQ_PLATFORM_PRODUCTION_NETWORK=sq_platform_production

# Optional host-only smoke-test binding. Caddy reaches the web container
# through EDGE_NETWORK; this port is not exposed publicly.
HCIS_BIND_ADDRESS=127.0.0.1
HCIS_HTTP_PORT=18080

POSTGRES_MEMORY_LIMIT=320m
API_MEMORY_LIMIT=192m
WEB_MEMORY_LIMIT=96m
