{
  "name": "hcisysq",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @hcis/web run dev",
    "dev:api": "npm --workspace @hcis/api run dev",
    "build:web": "npm --workspace @hcis/web run build",
    "build:api": "npm --workspace @hcis/api run build",
    "typecheck:web": "npm --workspace @hcis/web run typecheck",
    "typecheck:api": "npm --workspace @hcis/api run typecheck",
    "lint:web": "npm --workspace @hcis/web run lint",
    "lint:api": "npm --workspace @hcis/api run lint",
    "test:web": "npm --workspace @hcis/web run test",
    "test:api": "npm --workspace @hcis/api run test",
    "migrate:api": "npm --workspace @hcis/api run migrate",
    "migrations:check": "node apps/api/scripts/check-migration-source-of-truth.mjs",
    "migrations:rehearse-recovery": "node apps/api/scripts/rehearse-organization-migration-recovery.mjs",
    "auth:map-oidc-identity": "npm --workspace @hcis/api run auth:map-oidc-identity --",
    "employees:import": "npm --workspace @hcis/api run employees:import --",
    "db:up": "docker compose --env-file infra/.env.local -f infra/docker-compose.local.yml up -d postgres",
    "db:down": "docker compose --env-file infra/.env.local -f infra/docker-compose.local.yml down",
    "build": "npm run build:web && npm run build:api",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "lint": "npm run lint:web && npm run lint:api",
    "test": "npm run test:web && npm run test:api"
  }
}
