# RETIRED / ARCHIVED — DO NOT DEPLOY OR RECREATE
services:
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${POSTGRES_DB:?set POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER:?set POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
    volumes:
      - hcis_staging_pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 5s
      timeout: 3s
      retries: 20
    networks:
      - backend
    mem_limit: ${POSTGRES_MEMORY_LIMIT:-320m}
    shm_size: 128mb

  api:
    image: ${HCIS_API_IMAGE:-ghcr.io/imadjinasi/hcisysq-api:staging}
    restart: unless-stopped
    environment:
      NODE_ENV: production
      HOST: 0.0.0.0
      PORT: 3001
      DATABASE_URL: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
      AUTH_MODE: oidc
      AUTH_ENCRYPTION_KEY: ${AUTH_ENCRYPTION_KEY:?set AUTH_ENCRYPTION_KEY}
      AUTH_SESSION_TTL_HOURS: ${AUTH_SESSION_TTL_HOURS:-8}
      BIOMETRIC_COLLECTION_ENABLED: ${BIOMETRIC_COLLECTION_ENABLED:-0}
      BIOMETRIC_ACTIVE_KEY_ID: ${BIOMETRIC_ACTIVE_KEY_ID:-}
      BIOMETRIC_ENCRYPTION_KEYS: ${BIOMETRIC_ENCRYPTION_KEYS:-}
      OIDC_ISSUER: ${OIDC_ISSUER:?set OIDC_ISSUER}
      OIDC_CLIENT_ID: ${OIDC_CLIENT_ID:?set OIDC_CLIENT_ID}
      OIDC_CLIENT_SECRET: ${OIDC_CLIENT_SECRET:?set OIDC_CLIENT_SECRET}
      OIDC_REDIRECT_URI: ${OIDC_REDIRECT_URI:?set OIDC_REDIRECT_URI}
      OIDC_POST_LOGOUT_REDIRECT_URI: ${OIDC_POST_LOGOUT_REDIRECT_URI:?set OIDC_POST_LOGOUT_REDIRECT_URI}
      SQ_HUB_APPLICATION_ACCESS_URL: ${SQ_HUB_APPLICATION_ACCESS_URL:?set SQ_HUB_APPLICATION_ACCESS_URL}
      SQ_HUB_MACHINE_CLIENT_ID: ${SQ_HUB_MACHINE_CLIENT_ID:?set SQ_HUB_MACHINE_CLIENT_ID}
      SQ_HUB_MACHINE_CLIENT_SECRET: ${SQ_HUB_MACHINE_CLIENT_SECRET:?set SQ_HUB_MACHINE_CLIENT_SECRET}
    command:
      - sh
      - -c
      - node apps/api/dist/db/migrate.js && exec node apps/api/dist/server.js
    depends_on:
      postgres:
        condition: service_healthy
    expose:
      - "3001"
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - fetch('http://127.0.0.1:3001/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))
      interval: 10s
      timeout: 5s
      retries: 12
    networks:
      backend:
        aliases:
          - hcis-api-internal
      sq_platform_staging:
        aliases:
          - hcis-api-staging
    mem_limit: ${API_MEMORY_LIMIT:-192m}

  web:
    image: ${HCIS_WEB_IMAGE:-ghcr.io/imadjinasi/hcisysq-web:staging}
    restart: unless-stopped
    depends_on:
      api:
        condition: service_healthy
    ports:
      - "${HCIS_BIND_ADDRESS:-127.0.0.1}:${HCIS_HTTP_PORT:-18081}:80"
    expose:
      - "80"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 12
    networks:
      backend:
      edge_proxy:
        aliases:
          - hcis-staging-web
    mem_limit: ${WEB_MEMORY_LIMIT:-96m}

networks:
  backend:
    internal: true
  edge_proxy:
    external: true
    name: ${EDGE_NETWORK:-edge_proxy}
  sq_platform_staging:
    external: true
    name: ${SQ_PLATFORM_STAGING_NETWORK:-sq_platform_staging}

volumes:
  hcis_staging_pgdata:
